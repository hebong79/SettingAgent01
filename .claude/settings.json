{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash(npx vitest:*)",
      "Bash(npx tsc:*)",
      "Bash(npx tsx:*)",
      "Bash(npm run:*)",
      "Bash(npm test:*)",
      "Bash(node --check:*)",
      "Bash(node -e:*)",
      "Bash(curl:*)",
      "PowerShell(npx:*)",
      "PowerShell(npm:*)",
      "mcp__UnityMCP__*"
    ],
    "ask": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/id_rsa*)",
      "Read(**/*.pem)",
      "Read(**/credentials.json)",
      "Read(**/.npmrc)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Bash(npm publish:*)",
      "Bash(gh pr:*)",
      "Bash(gh release:*)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  }
}
