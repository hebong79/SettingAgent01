# SettingAgent 비밀값 템플릿. 이 파일을 `.env` 로 복사한 뒤 값만 채운다(.env 는 git 무시 대상).
# config/*.json 에는 환경변수 "이름"만 적고(passwordEnv·apiKeyEnv), 값은 여기(process.env)에만 둔다.
# 이미 셸/서비스에 설정된 환경변수가 있으면 .env 값보다 우선한다(Node process.loadEnvFile 동작).

# 리얼 카메라 2(cameraSources[real-camera-2].passwordEnv) 관리자 비밀번호
CAM_REAL2_PASSWORD=

# 아래는 기존 apiKeyEnv 규약 키(각 서비스가 인증을 요구할 때만 채운다)
# VPD_API_KEY=
# LPD_API_KEY=
# SETTING_API_KEY=
