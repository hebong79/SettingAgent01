# ── Node ──────────────────────────────────────────────
node_modules/
dist/
build/
*.tsbuildinfo
.vite/
coverage/

# ── Python (Sub/*_api) ────────────────────────────────
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/

# ── 런타임 산출물/캡처 ────────────────────────────────
**/data/captures/
# 정밀수집 결과 저장 스냅샷(런타임 누적, 커밋 제외)
SettingAgent/save/
# 정밀수집 결과 보조 미러(reports/*, 런타임 누적, 커밋 제외)
SettingAgent/reports/
# 검출 프레임 아카이브(27-B). 위 reports/ 규칙이 이미 덮지만 **결정을 명시**해 둔다 —
# 사이드카(JSON)만 추적하는 안을 검토했으나 기각: 그림 없는 메타는 재현이 불가능한데(이 기능의 목적)
# 보존정책이 오래된 쌍을 지우므로 git 에는 삭제 이력만 무한 누적된다. 골든 프레임 세트(21MB)를
# 커밋에서 뺀 15회차 결정과 같은 취급이다. 대신 **서버가 항상 main 체크아웃에서 돌므로**
# 워크트리에서 작업해도 프레임은 이 한 자리에 모인다(26-1 의 "워크트리에서 복사" 문제의 실제 해법).
SettingAgent/reports/detect_frames/
*.log
# 센터라이징 기준 프레임(런타임 생성 JPEG, 커밋 제외)
SettingAgent/data/refframes/
# 코드 진단 스크래치(일회성 진단 산출물, 커밋 제외)
SettingAgent/_diag_chord/
# 자동 바닥 ROI 골든 프레임 세트(회차 간 비교 기준. 21MB — 마스터 결정으로 커밋 제외, 15회차)
SettingAgent/test/fixtures/roiAutoGolden/
SettingAgent/test/fixtures/roiAutoGolden_v2/
# 실카 낮 프레임 예약 캡처 세트(런타임 누적 JPEG. 골든 세트와 같은 취급 — 마스터 결정, 18회차)
SettingAgent/test/fixtures/realCamDaylight/
# 정밀 수집 관측 DB(런타임 누적, 커밋 제외)
*.sqlite
*.sqlite-shm
*.sqlite-wal

# ── 환경/비밀 ─────────────────────────────────────────
.env
.env.*
!.env.example
**/settings.local.json
.logfire/
**/*credentials*.json

# ── OS/에디터 ─────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp

# 런타임 로그(회전 파일)
logs/
SettingAgent/logs/

# 세션 워크트리(transient — 워크트리 기본 정책이 .claude/worktrees/ 아래 생성)
.claude/worktrees/

# 2번째 SettingAgent 인스턴스(port 13021) 전용 고정 실행 디렉터리.
# src/web/node_modules 는 메인 체크아웃을 가리키는 정션이고 config/data/save/reports 만
# 실제 사본이다. 전부 로컬 런타임 자원이라 커밋 대상이 아니다.
SettingAgent-13021/

# 위 인스턴스를 MCP 로 물리는 프로젝트 스코프 등록. 절대경로(D:\...)가 박히는
# 로컬 전용 설정이라 커밋하지 않는다. local 스코프(~/.claude.json)는 실행 중인
# 세션이 자기 시작 시점 설정으로 덮어써 등록이 소실되므로 파일 스코프를 쓴다.
.mcp.json

# 하네스 설정 백업(예: settings.json.bak_20260728). 과거 allow 목록에 평문 자격증명이
# 섞여 있어 절대 커밋되면 안 된다.
.claude/*.bak_*

# DB 수동 백업본(예: setting.sqlite.bak-presetinfo-20260724_145745[-wal|-shm]).
# 위의 *.sqlite* 패턴은 확장자로 끝나는 이름만 잡아 .bak-<태그> 형태를 놓친다(WAL 이 3MB 급이라 반드시 제외).
*.sqlite.bak-*

# 정본 ROI 자동 백업(승인 적용 시 런타임 생성 — 커밋 대상 아님)
SettingAgent/data/Place01/PtzCamRoi.*.bak.json

# 도구가 흘린 빈 껍데기 임시 산출물(37B, {"createdAt":"T","items":[]}).
# 실제 시각이 아니라 문자 "T" 가 박힌 미완성 템플릿이며 참조하는 코드가 없다.
SettingAgent/x.json
